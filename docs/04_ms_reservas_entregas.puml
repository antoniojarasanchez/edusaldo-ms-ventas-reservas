@startuml 04_ms_reservas_entregas
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  ArrowColor #1F4E79
}
skinparam package {
  BorderColor #1F4E79
  BackgroundColor #EEF4FA
}
hide empty members
skinparam nodesep 45
skinparam ranksep 55
title EduSaldo · MS Reservas y Entregas (8084) · db_reservas\nReservas, entregas por concepto y aviso al apoderado

legend top right
  «ADM» Administrador · «ENC» Encargado · «APO» Apoderado
  «ALU» Alumno (≥ 12 años) · «SIS» sistema / otro microservicio
  Clases <<ref MS ...>>: viven en otro microservicio; aquí solo
  se guarda su id (sin relación JPA entre bases de datos).
endlegend

package "Referencias externas (MS Usuarios e Inventario)" #F7F7F7 {
  class Apoderado <<ref MS Usuarios>> {
    - id : Long
    - correo : String
  }
  class Alumno <<ref MS Usuarios>> {
    - id : Long
    - correo : String
  }
  class Producto <<ref MS Inventario>> {
    - id : Long
    - nombre : String
    - precio : int
  }
}

package "MS Reservas y Entregas" {

  enum EstadoReserva {
    PENDIENTE
    LISTA_PARA_RETIRO
    ENTREGADA
    CANCELADA
  }

  enum OrigenEntrega {
    RESERVA
    MESON
  }

  class Reserva {
    - codigo : String
    - alumnoId : Long
    - creadaPorId : Long
    - fechaCreacion : LocalDateTime
    - total : int
    - estado : EstadoReserva
    - motivoCancelacion : String [0..1]
    - preparadaPorId : Long [0..1]
    - fechaPreparacion : LocalDateTime [0..1]
    --
    + agregarDetalle(productoId : Long, cantidad : int) : void «APO» «ALU»
    + calcularTotal() : int
    + confirmar() : void «APO» «ALU»
    + marcarListaParaRetiro(encargadoId : Long) : void «ENC»
    + cancelar(motivo : String) : void «ENC» «APO» «ALU»
    + confirmarRetiroYGenerarEntrega(encargadoId : Long) : Entrega «ENC»
    + notificarApoderadosPorCorreo() : void «SIS»
  }

  class DetalleReserva {
    - productoId : Long
    - nombreProducto : String
    - cantidad : int
    - precioUnitario : int
    --
    + getSubtotal() : int
  }

  class Entrega {
    - numero : String
    - alumnoId : Long
    - origen : OrigenEntrega
    - fecha : LocalDateTime
    - total : int
    - encargadoId : Long
    --
    + calcularTotal() : int
    + cobrarSaldoEnMsSaldos() : void «SIS»
    + descontarStockEnMsInventario() : void «SIS»
    + notificarApoderadosPorCorreo() : void «SIS»
    + registrarEnMeson(...) : Entrega «ENC»
  }

  class DetalleEntrega {
    - productoId : Long
    - nombreProducto : String
    - cantidad : int
    - precioUnitario : int
    - cantidadDevuelta : int
    --
    + getSubtotal() : int
  }

  class Devolucion {
    - fecha : LocalDateTime
    - motivo : String
    - totalReintegro : int
    - encargadoId : Long
    --
    + registrar(...) : void «ENC»
  }

  class DetalleDevolucion {
    - cantidad : int
    - montoReintegro : int
  }
}

' Referencias externas (hacia otros MS por ID)
Reserva "0..*" ..> "1" Alumno : destinatario (alumnoId) >
Reserva "0..*" ..> "1" Apoderado : notifica a (vía alumnoId) >
Entrega "0..*" ..> "1" Alumno : entregada a (alumnoId) >
Entrega "0..*" ..> "1" Apoderado : notifica a (vía alumnoId) >
DetalleReserva "0..*" ..> "1" Producto : (productoId) >
DetalleEntrega "0..*" ..> "1" Producto : (productoId) >

' Relaciones internas
Reserva "1" *-- "1..*" DetalleReserva
Reserva "0..1" -- "0..1" Entrega : al retirarse genera >
Entrega "1" *-- "1..*" DetalleEntrega
Entrega "1" -- "0..*" Devolucion
Devolucion "1" *-- "1..*" DetalleDevolucion
DetalleDevolucion "0..*" --> "1" DetalleEntrega : revierte >

' Conexión de Enums con sus Clases
Reserva ..> EstadoReserva : estado
Entrega ..> OrigenEntrega : origen

note right of Reserva
  Reserva: la crea el Apoderado (para cualquiera de sus
  hijos) o el Alumno de 12 años o más (para sí mismo).
  Al confirmar se retiene saldo (MS Saldos) y stock
  (MS Inventario).
  notificarApoderadosPorCorreo(): cuando un alumno
  reserva o el encargado marca LISTA_PARA_RETIRO,
  consulta en MS Usuarios a los apoderados del alumno
  y les remite la notificación por correo.
  Trazabilidad (HU31 CA2): preparadaPorId y
  fechaPreparacion registran quién armó el pedido y cuándo.
  Se entrega COMPLETA: confirmarRetiroYGenerarEntrega()
  crea la Entrega y la reserva pasa a ENTREGADA.
  Pueden cancelarla ENC, APO y ALU antes del retiro.
end note

note right of Entrega
  "Entrega por concepto" (antes Venta): el dinero ya
  fue abonado, aquí solo se entregan materiales.
  cobrarSaldoEnMsSaldos(): MS Saldos ejecuta
  CuentaSaldo.cobrarEntregaMateriales().
  descontarStockEnMsInventario(): MS Inventario ejecuta
  Producto.descontarStockPorEntrega().
  notificarApoderadosPorCorreo(): acción interna; envía un
  correo a cada apoderado con el detalle entregado
  (sin persistir el estado del envío).
  Origen MESON: alumno se identifica en el mesón.
end note
@enduml