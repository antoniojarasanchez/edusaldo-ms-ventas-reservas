@startuml 04_ms_ventas_reservas
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  ArrowColor #1F4E79
}
skinparam package {
  BorderColor #1F4E79
  BackgroundColor #EEF4FA
}
hide empty members
title EduSaldo · MS Reservas y Entregas (8084) · db_reservas\nReservas, entregas por concepto y aviso al apoderado

legend top right
  «ADM» Administrador · «ENC» Encargado · «APO» Apoderado
  «ALU» Alumno (≥ 12 años) · «SIS» sistema / otro microservicio
endlegend

package "MS Reservas y Entregas" {

  enum EstadoReserva {
    PENDIENTE
    LISTA_PARA_RETIRO
    ENTREGADA
    CANCELADA
  }

  enum OrigenEntrega {
    RESERVA
    MESON
  }

  enum EstadoNotificacion {
    ENVIADA
    FALLIDA
  }

  class Reserva <<Entity>> {
    - id : Long
    - codigo : String {unique}
    - alumnoId : Long
    - creadaPorId : Long
    - fechaCreacion : LocalDateTime
    - total : int
    - estado : EstadoReserva
    - motivoCancelacion : String [0..1]
    --
    + agregarDetalle(productoId : Long, cantidad : int) : void «APO» «ALU»
    + calcularTotal() : int
    + confirmar() : void «APO» «ALU»
    + marcarLista(encargadoId : Long) : void «ENC»
    + cancelar(motivo : String) : void «ENC» «APO»
    + entregar(encargadoId : Long) : Entrega «ENC»
  }

  class DetalleReserva <<Entity>> {
    - id : Long
    - productoId : Long
    - nombreProducto : String
    - cantidad : int
    - precioUnitario : int
    --
    + getSubtotal() : int
  }

  class Entrega <<Entity>> {
    - id : Long
    - numero : String {unique}
    - alumnoId : Long
    - origen : OrigenEntrega
    - fecha : LocalDateTime
    - total : int
    - encargadoId : Long
    --
    + calcularTotal() : int
    + descontarDelSaldo() : void «SIS»
    + descontarDelStock() : void «SIS»
    + notificarApoderados() : void «SIS»
    + registrarEnMeson(...) : Entrega «ENC»
  }

  class DetalleEntrega <<Entity>> {
    - id : Long
    - productoId : Long
    - nombreProducto : String
    - cantidad : int
    - precioUnitario : int
    - cantidadDevuelta : int
    --
    + getSubtotal() : int
  }

  class Devolucion <<Entity>> {
    - id : Long
    - fecha : LocalDateTime
    - motivo : String
    - totalReintegro : int
    - encargadoId : Long
    --
    + registrar(...) : void «ENC»
  }

  class DetalleDevolucion <<Entity>> {
    - id : Long
    - cantidad : int
    - montoReintegro : int
  }

  class NotificacionEntrega <<Entity>> {
    - id : Long
    - apoderadoId : Long
    - correoDestino : String
    - fechaEnvio : LocalDateTime
    - estado : EstadoNotificacion
  }
}

Reserva "1" *-- "1..*" DetalleReserva
Reserva "0..1" -- "0..1" Entrega : al retirarse genera >
Entrega "1" *-- "1..*" DetalleEntrega
Entrega "1" -- "0..*" Devolucion
Devolucion "1" *-- "1..*" DetalleDevolucion
DetalleDevolucion "0..*" --> "1" DetalleEntrega : revierte >
Entrega "1" *-- "1..*" NotificacionEntrega : avisa >

note right of Reserva
  Reserva: la crea el Apoderado, o el Alumno
  si tiene 12 años o más (creadaPorId).
  Al confirmar se compromete saldo (MS Saldos)
  y stock (MS Inventario).
  Se entrega COMPLETA: entregar() crea la Entrega
  y la reserva pasa a ENTREGADA.
end note

note right of Entrega
  "Entrega por concepto" (antes Venta): el dinero ya
  fue abonado, aquí solo se entregan materiales.
  descontarDelSaldo(): pasa el monto comprometido
  a descontado del total del alumno (MS Saldos).
  descontarDelStock(): baja el stock físico.
  notificarApoderados(): envía un correo a cada
  apoderado del alumno con el detalle entregado.
  Origen MESON: alumno se identifica en el mesón.
end note
@enduml
